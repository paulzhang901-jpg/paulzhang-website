{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "paulzhang-together-submissions",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [
    {"pattern": "paulzhang.org/api/together*", "zone_name": "paulzhang.org"},
    {"pattern": "www.paulzhang.org/api/together*", "zone_name": "paulzhang.org"}
  ],
  "send_email": [
    {"name": "EMAIL", "destination_address": "paulzhang901@gmail.com"}
  ]
}
