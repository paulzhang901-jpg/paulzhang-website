{
  "name": "paulzhang-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual life-formation foundation for paulzhang.org",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:architecture && pnpm run test:routes && pnpm run test:content-integrity && pnpm run test:translation && pnpm run test:product && pnpm run test:accessibility && pnpm run test:performance && pnpm run test:security",
    "test:content": "pnpm run test:content-integrity && pnpm run test:translation",
    "test:content-integrity": "node --import tsx --test tests/content/content-model.test.ts tests/content/repository.test.ts",
    "test:translation": "node --import tsx --test tests/content/translation-integrity.test.ts",
    "test:routes": "node --test tests/runtime/*.test.mjs && node --import tsx --test tests/routes/*.test.ts",
    "test:accessibility": "node --test tests/accessibility/*.test.mjs",
    "test:performance": "node --test tests/quality/*.test.mjs",
    "test:product": "node --import tsx --test tests/product/*.test.ts && node --test tests/product/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "validate:architecture": "node tests/architecture/validate.mjs",
    "validate:content": "node --import tsx src/lib/content/validate-cli.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "gray-matter": "4.0.3",
    "next": "16.3.2",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {"node": ">=20.9.0"}
}
